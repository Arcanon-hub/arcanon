{
  "name": "@arcanon/plugin",
  "version": "0.2.0",
  "description": "Arcanon — cross-repo service dependency scanner for Claude Code",
  "license": "Apache-2.0",
  "author": "Arcanon",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Arcanon-hub/arcanon"
  },
  "homepage": "https://arcanon.dev",
  "keywords": [
    "claude-code",
    "plugin",
    "arcanon",
    "service-graph",
    "cross-repo",
    "dependency-mapping",
    "identity",
    "privacy",
    "auth",
    "drift-detection"
  ],
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/static": "^9.1.1",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "chromadb": "^3.3.3",
    "fastify": "^5.8.5",
    "js-yaml": "^4.2.0",
    "picomatch": "^4.0.4",
    "zod": "^3.25.0"
  },
  "scripts": {
    "test": "export NODE_OPTIONS=\"--import ./worker/test-setup.mjs\"; find worker -name '*.test.js' -not -path '*/node_modules/*' -print0 | xargs -0 node --test",
    "test:storage": "export NODE_OPTIONS=\"--import ./worker/test-setup.mjs\"; node --test worker/db/query-engine-*.test.js",
    "test:hub-sync": "export NODE_OPTIONS=\"--import ./worker/test-setup.mjs\"; find worker/hub-sync -name '*.test.js' -print0 | xargs -0 node --test",
    "test:migrations": "export NODE_OPTIONS=\"--import ./worker/test-setup.mjs\"; node --test worker/db/migration-*.test.js worker/db/migrations.test.js"
  }
}
